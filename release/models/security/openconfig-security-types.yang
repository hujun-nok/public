module openconfig-security-types {

  yang-version "1";
  namespace "http://openconfig.net/yang/security/types";
  prefix "oc-sec-types";

  import openconfig-extensions {
    prefix oc-ext;
  }

// meta
  organization
    "OpenConfig working group";

  contact
    "OpenConfig working group
     netopenconfig@googlegroups.com";

  description
    "This module defines identities and types used with the OpenConfig
    security modules.";

  oc-ext:openconfig-version "0.4.0";

  revision 2026-10-12 {
    description
      "Rename DH_GROUP identities to KE_METHOD. Remove the
       security-association-lifetime type.";
    reference
      "0.4.0";
  }

  revision 2026-10-08 {
    description
      "Add IPsec encryption, integrity, and PRF algorithm
       identities, and the security association lifetime type.";
    reference
      "0.2.0";
  }

  revision 2025-12-10 {
    description
      "Initial model with identities for IPSec.";
    reference
      "0.1.0";
  }

// OpenConfig specific extensions for module metadata.
  oc-ext:regexp-posix;
  oc-ext:catalog-organization "openconfig";
  oc-ext:origin "openconfig";

  // --- Base and Derived Identities ---
  identity CONNECTION_STATUS {
    description
      "Base identity for the operational status of an IPsec
       connection";
  }
  identity UNKNOWN {
    base CONNECTION_STATUS;
    description
      "No connection state is currently present or known.";
  }
  identity CONNECTING {
    base CONNECTION_STATUS;
    description
      "In the process of negotiating an IPsec connection.";
  }
  identity IDLE {
    base CONNECTION_STATUS;
    description
      "Waiting for an incoming IPsec negotiation.";
  }
  identity ACTIVE {
    base CONNECTION_STATUS;
    description
      "The IPsec negotiation is complete and ready for data
       transfer.";
  }
  identity INVALID {
    base CONNECTION_STATUS;
    description
      "The connection is in an invalid state due to a
       configuration or system error that prevents connection
       establishment.";
  }
  identity ESTABLISHED {
    base CONNECTION_STATUS;
    description
      "The IPsec negotiation is complete.";
  }

  identity CONNECTION_ROLE {
    description
      "Base identity for the role of IPsec connection.";
  }
  identity INITIATOR {
    base CONNECTION_ROLE;
    description
      "This device starts the connection attempt.";
  }
  identity RESPONDER {
    base CONNECTION_ROLE;
    description
      "This device only accepts incoming connection requests.";
  }

  identity KE_METHOD {
    description
      "Base identity for key exchange methods used for IKE and
       perfect forward secrecy.";
  }
  identity KE_METHOD_1 {
    base KE_METHOD;
    description
      "Key exchange method 1 (768 bit MODP group)";
  }
  identity KE_METHOD_2 {
    base KE_METHOD;
    description
      "Key exchange method 2 (1024 bit MODP group)";
  }
  identity KE_METHOD_5 {
    base KE_METHOD;
    description
      "Key exchange method 5 (1536 bit MODP group)";
  }
  identity KE_METHOD_14 {
    base KE_METHOD;
    description
      "Key exchange method 14 (2048 bit MODP group)";
  }
  identity KE_METHOD_15 {
    base KE_METHOD;
    description
      "Key exchange method 15 (3072 bit MODP group)";
  }
  identity KE_METHOD_16 {
    base KE_METHOD;
    description
      "Key exchange method 16 (4096 bit MODP group)";
  }
  identity KE_METHOD_17 {
    base KE_METHOD;
    description
      "Key exchange method 17 (6144 bit MODP group)";
  }
  identity KE_METHOD_19 {
    base KE_METHOD;
    description
      "Key exchange method 19 (256 bit ECP group)";
  }
  identity KE_METHOD_20 {
    base KE_METHOD;
    description
      "Key exchange method 20 (384 bit ECP group)";
  }
  identity KE_METHOD_21 {
    base KE_METHOD;
    description
      "Key exchange method 21 (521 bit ECP group)";
  }
  identity KE_METHOD_24 {
    base KE_METHOD;
    description
      "Key exchange method 24 (2048 bit MODP group with 256 bit subgroup)";
  }

  identity IKE_AUTH_METHOD {
    description
      "Base identity for the authentication method used in the IKE exchange.";
  }
  identity PRE_SHARED_KEY {
    base IKE_AUTH_METHOD;
    description
      "Authentication using a pre-configured symmetric key (PSK).";
  }
  identity PKI_CERTS {
    base IKE_AUTH_METHOD;
    description
      "Authentication using PKI certificates.";
  }

  identity IKE_VERSION {
    description
      "Base identity for the Internet Key Exchange protocol version.";
  }
  identity IKEV1 {
    base IKE_VERSION;
    description
      "Internet Key Exchange Protocol Version 1 (Legacy).";
  }
  identity IKEV2 {
    base IKE_VERSION;
    description
      "Internet Key Exchange Protocol Version 2 (Recommended standard).";
  }

  identity IPSEC_MODE {
    description
      "Base identity for the IPsec mode of operation.";
  }
  identity TUNNEL {
    base IPSEC_MODE;
    description
      "IPsec Tunnel mode, where the original IP packet is encapsulated with new IP headers.";
  }
  identity TRANSPORT {
    base IPSEC_MODE;
    description
      "IPsec Transport mode, where the IPsec header is inserted between the original IP header and the transport layer (TCP/UDP).";
  }

  identity IPSEC_PROTOCOL {
    description
      "Base identity for the IPsec protocol encapsulation.";
  }
  identity IPPROTO_ESP {
    base IPSEC_PROTOCOL;
    description
      "Encapsulating Security Payload (ESP), providing confidentiality (encryption), integrity, and authentication.";
  }
  identity IPPROTO_AH {
    base IPSEC_PROTOCOL;
    description
      "Authentication Header (AH), providing integrity and authentication, but *no* confidentiality (encryption).";
  }

  identity SA_DIRECTION {
    description
      "Base identity for the direction of a Security Association.";
  }
  identity EGRESS {
    base SA_DIRECTION;
    description
      "The Security Association used for encrypting outgoing traffic.";
  }
  identity INGRESS {
    base SA_DIRECTION;
    description
      "The Security Association used for decrypting incoming traffic.";
  }

  identity TUNNEL_MODE {
    description
      "Base identity for the encapsulation mode of the tunnel interface.";
  }
  identity IPSEC {
    base TUNNEL_MODE;
    description
      "A Layer 3 IPsec tunnel, often referred to as a VTI (Virtual Tunnel Interface) or equivalent, used for route-based VPNs.";
  }
  identity GRE {
    base TUNNEL_MODE;
    description
      "Generic Routing Encapsulation (GRE) tunnel encapsulation.";
  }

  identity IPSEC_ENCRYPTION_ALGORITHM {
    description
      "Base identity for IPsec and IKE encryption algorithms.";
  }

  identity TRIPLE_DES_CBC {
    base IPSEC_ENCRYPTION_ALGORITHM;
    description
      "Triple Data Encryption Standard in CBC mode.";
  }

  identity AES_128_CBC {
    base IPSEC_ENCRYPTION_ALGORITHM;
    description
      "AES with a 128-bit key in CBC mode.";
  }

  identity AES_192_CBC {
    base IPSEC_ENCRYPTION_ALGORITHM;
    description
      "AES with a 192-bit key in CBC mode.";
  }

  identity AES_256_CBC {
    base IPSEC_ENCRYPTION_ALGORITHM;
    description
      "AES with a 256-bit key in CBC mode.";
  }

  identity AES_128_GCM_8 {
    base IPSEC_ENCRYPTION_ALGORITHM;
    description
      "AES with a 128-bit key in GCM mode and an 8-octet ICV.";
  }

  identity AES_128_GCM_16 {
    base IPSEC_ENCRYPTION_ALGORITHM;
    description
      "AES with a 128-bit key in GCM mode and a 16-octet ICV.";
  }

  identity AES_256_GCM_8 {
    base IPSEC_ENCRYPTION_ALGORITHM;
    description
      "AES with a 256-bit key in GCM mode and an 8-octet ICV.";
  }

  identity AES_256_GCM_16 {
    base IPSEC_ENCRYPTION_ALGORITHM;
    description
      "AES with a 256-bit key in GCM mode and a 16-octet ICV.";
  }

  identity NULL_AES_128_GMAC {
    base IPSEC_ENCRYPTION_ALGORITHM;
    description
      "Null encryption with AES-128 GMAC authentication.";
  }

  identity NULL_AES_192_GMAC {
    base IPSEC_ENCRYPTION_ALGORITHM;
    description
      "Null encryption with AES-192 GMAC authentication.";
  }

  identity NULL_AES_256_GMAC {
    base IPSEC_ENCRYPTION_ALGORITHM;
    description
      "Null encryption with AES-256 GMAC authentication.";
  }

  identity IPSEC_INTEGRITY_ALGORITHM {
    description
      "Base identity for IPsec and IKE integrity algorithms.";
  }

  identity HMAC_SHA_1 {
    base IPSEC_INTEGRITY_ALGORITHM;
    description
      "AUTH_HMAC_SHA1_96 algorithm.";
  }

  identity HMAC_SHA_256 {
    base IPSEC_INTEGRITY_ALGORITHM;
    description
      "AUTH_HMAC_SHA2_256_128 algorithm.";
  }

  identity HMAC_SHA_384 {
    base IPSEC_INTEGRITY_ALGORITHM;
    description
      "AUTH_HMAC_SHA2_384_192 algorithm.";
  }

  identity HMAC_SHA_512 {
    base IPSEC_INTEGRITY_ALGORITHM;
    description
      "AUTH_HMAC_SHA2_512_256 algorithm.";
  }

  identity AUTHENTICATION_ENCRYPTION {
    base IPSEC_INTEGRITY_ALGORITHM;
    description
      "Integrity is provided by an authenticated encryption
       algorithm and no separate integrity algorithm is used.";
  }

  identity IPSEC_PRF_ALGORITHM {
    description
      "Base identity for IKE pseudorandom function algorithms.";
  }

  identity PRF_HMAC_SHA_1 {
    base IPSEC_PRF_ALGORITHM;
    description
      "Pseudorandom function based on PRF_HMAC_SHA1.";
  }

  identity PRF_HMAC_SHA_256 {
    base IPSEC_PRF_ALGORITHM;
    description
      "Pseudorandom function based on PRF_HMAC_SHA2_256.";
  }

  identity PRF_HMAC_SHA_384 {
    base IPSEC_PRF_ALGORITHM;
    description
      "Pseudorandom function based on PRF_HMAC_SHA2_384.";
  }

  identity PRF_HMAC_SHA_512 {
    base IPSEC_PRF_ALGORITHM;
    description
      "Pseudorandom function based on PRF_HMAC_SHA2_512.";
  }

  identity PRF_AES_XCBC {
    base IPSEC_PRF_ALGORITHM;
    description
      "Pseudorandom function based on PRF_AES128_XCBC.";
  }

  identity PRF_SAME_AS_INTEGRITY {
    base IPSEC_PRF_ALGORITHM;
    description
      "Use the integrity algorithm as the pseudorandom function.";
  }
// augment statements
// rpc statements
// notification statements
}